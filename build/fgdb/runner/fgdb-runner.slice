# Reference unit. build/fgdb/runner/setup-runner.sh writes the live unit
# on the runner from FGDB_CPU_QUOTA, FGDB_MEMORY_HIGH, and FGDB_MEMORY_MAX,
# or from the defaults below. Lower the caps when the host runs other services.
[Unit]
Description=FutureGadgetDatabases GitHub Actions runner slice
Documentation=https://github.com/Future-Gadget-Laboratories/FutureGadgetDatabases/blob/main/docs/fgdb/RUNNER.md

[Slice]
CPUAccounting=yes
MemoryAccounting=yes
CPUQuota=2400%
MemoryHigh=80G
MemoryMax=96G
