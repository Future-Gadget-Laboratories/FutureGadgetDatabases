load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "repstream",
    srcs = ["api.go"],
    importpath = "github.com/cockroachdb/cockroach/pkg/repstream",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/sql/clusterunique",
        "//pkg/sql/isql",
        "//pkg/sql/sem/eval",
        "@com_github_cockroachdb_errors//:errors",
    ],
)

go_test(
    name = "repstream_test",
    srcs = ["api_test.go"],
    embed = [":repstream"],
    deps = [
        "//pkg/sql/clusterunique",
        "//pkg/sql/isql",
        "//pkg/sql/sem/eval",
    ],
)
