load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "capabilities",
    testonly = True,
    srcs = [
        "run.go",
        "sql.go",
    ],
    importpath = "github.com/cockroachdb/cockroach/pkg/fgdbtest/capabilities",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/fgdbtest/cluster",
        "//pkg/fgdbtest/labels",
        "//pkg/fgdbtest/report",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)

go_test(
    name = "capabilities_test",
    srcs = ["capabilities_test.go"],
    embed = [":capabilities"],
    deps = [
        "//pkg/fgdbtest/labels",
        "//pkg/fgdbtest/report",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)
